// RocketRide Pipeline: creative_generation.pipe
// Formulates creative briefs and generates multi-variant hooks & scripts using HookLabs creative intelligence.

pipeline "creative_generation" {
  description = "Generates high-converting creative concepts, hooks, and scripts using intelligence memory patterns"

  input {
    campaign_goal    = string
    target_audience  = string
    product_name     = string
    creative_memory  = object
  }

  node "strategy_agent" {
    type  = "agent"
    model = "openai/gpt-4o"
    role  = "Creative Strategist"
    prompt = """
      Using compounding creative memory {{input.creative_memory}}, formulate a creative brief for {{input.product_name}}.
      Target Audience: {{input.target_audience}}
      Goal: {{input.campaign_goal}}
    """
  }

  node "hook_agent" {
    type  = "agent"
    model = "anthropic/claude-3-5-sonnet"
    role  = "Master Copywriter & Hook Specialist"
    prompt = """
      Based on Strategy Brief: {{strategy_agent.output}}
      Generate 3 distinct, high-impact hook variations:
      1. Pattern Interrupt Hook
      2. Statistical / Evidence Hook
      3. Curiosity Gap Hook
    """
  }

  node "script_agent" {
    type  = "agent"
    model = "anthropic/claude-3-5-sonnet"
    role  = "Short-Form Video Scriptwriter"
    prompt = """
      For each hook generated by Hook Agent {{hook_agent.output}}, write a complete 30-second short-form ad script with visual cues, voiceover script, and Call To Action (CTA).
    """
  }

  output {
    creative_brief   = "{{strategy_agent.output}}"
    hook_variants    = "{{hook_agent.output.hooks}}"
    scripts          = "{{script_agent.output.scripts}}"
  }
}
