# ================================================================
# HookLabs × RocketRide Buildathon — Environment Variables (.env.local)
# Copy this file to .env.local and populate values.
# DO NOT COMMIT .env.local to Git repository.
# ================================================================

# ── 1. NEW HACKATHON SUPABASE INSTANCE (Required) ────────────────
# Create a NEW Supabase project for the hackathon. DO NOT use production keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-hackathon-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_hackathon_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_hackathon_supabase_service_role_key_here

# ── 2. ROCKETRIDE AI ORCHESTRATION ENGINE (Required) ──────────────
# Required for running load-bearing .pipe agent workflows
ROCKETRIDE_API_KEY=your_rocketride_api_key_here
ROCKETRIDE_URI=https://api.rocketride.ai

# ── 3. REUSED AI PROVIDER ACCOUNTS (Required) ───────────────────
# Reuse existing API provider keys where available
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ── 4. OPTIONAL INTEGRATIONS ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_pro_id
STRIPE_TEAM_PRICE_ID=price_team_id

REMOTION_AWS_ACCESS_KEY=your_aws_access_key
REMOTION_AWS_SECRET_KEY=your_aws_secret_key
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=remotion-render

CRON_SECRET=your_random_cron_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
